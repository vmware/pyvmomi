             serverd: Host server agent
             install: Installation
             vpxClient: Virtual infrastructure client
             recordLog: System Record Log
         """
         vpxd: _typing.ClassVar['DiagnosticManager.LogDescriptor.Creator'] = 'vpxd'
         vpxa: _typing.ClassVar['DiagnosticManager.LogDescriptor.Creator'] = 'vpxa'
         hostd: _typing.ClassVar['DiagnosticManager.LogDescriptor.Creator'] = 'hostd'
         serverd: _typing.ClassVar['DiagnosticManager.LogDescriptor.Creator'] = 'serverd'
         install: _typing.ClassVar['DiagnosticManager.LogDescriptor.Creator'] = 'install'
         vpxClient: _typing.ClassVar['DiagnosticManager.LogDescriptor.Creator'] = 'vpxClient'
         recordLog: _typing.ClassVar['DiagnosticManager.LogDescriptor.Creator'] = 'recordLog'

      class Format(pyVmomi.VmomiSupport.Enum):
         """
         Constants for defined formats.
         
         For more information, see the comment for the format property.
         
