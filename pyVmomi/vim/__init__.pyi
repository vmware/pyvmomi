class LocalizationManager(pyVmomi.VmomiSupport.ManagedObject):
   """
   `pyVmomi.vim.LocalizationManager` provides access to descriptions of
   the message catalogs that are available for client-side message
   localization.
   
   Clients of the VIM API may use
   `pyVmomi.vim.SessionManager`.`pyVmomi.vim.SessionManager.setLocale`
   to cause the server to emit localized messages, or may perform
   client-side localization based on message catalogs provided by the
   `pyVmomi.vim.LocalizationManager`.
   
   A message catalog is a file that contains a set of key-value pairs.
   - The key is an ASCII string that identifies the message.
   - The value is a UTF-8 string that contains the text of the message, sometimes
     containing substitution variables.
     
   The server will localize fields tagged with 'localizable' based on the
   value of the `pyVmomi.vim.UserSession`.`pyVmomi.vim.UserSession.locale`
   and `pyVmomi.vim.UserSession.messageLocale` properties which are set via
   `pyVmomi.vim.SessionManager`.`pyVmomi.vim.SessionManager.setLocale`.
   
   The following list shows some of the ways that vSphere uses localized
   messages.
   - Current task status (`pyVmomi.vim.TaskInfo`.`pyVmomi.vim.TaskInfo.description`)
   - Events (`pyVmomi.vim.vm.Message`.`pyVmomi.vim.vm.Message.text` and
     Questions (`pyVmomi.vim.vm.QuestionInfo`.`pyVmomi.vim.vm.QuestionInfo.text`)
   - Faults (`pyVmomi.vmodl.MethodFault`.`pyVmomi.vmodl.MethodFault.faultMessage`)
   - `pyVmomi.vim.profile.host.HostProfile` and
     `pyVmomi.vim.profile.cluster.ClusterProfile` descriptions
     (`pyVmomi.vim.profile.Profile`.`pyVmomi.vim.profile.Profile.Description`.
     `pyVmomi.vim.profile.Profile.description` returned by the
     `pyVmomi.vim.profile.Profile`.`pyVmomi.vim.profile.Profile.retrieveDescription` method)
   """
   class MessageCatalog(pyVmomi.vmodl.DynamicData):
      """
      Description of an available message catalog
      
      Attributes:
          moduleName: The module or extension that publishes this catalog.
              
              The moduleName will be empty for the core catalogs for the
              VirtualCenter server itself.
          catalogName: The name of the catalog.
          locale: The locale for the catalog.
          catalogUri: The URI (relative to the connection URL for the VirtualCenter server
              itself) from which the catalog can be downloaded.
              
              The caller will need to augment this with a scheme and authority (host
              and port) to make a complete URL.
          lastModified: The last-modified time of the catalog file, if available
          md5sum: The checksum of the catalog file, if available
          version: The version of the catalog file, if available
              The format is dot-separated version string, e.g.
              
              \"1.2.3\".
      """
      moduleName: str
      catalogName: str
      locale: str
      catalogUri: str
      lastModified: _typing.Optional[_datetime.datetime] = None
      md5sum: _typing.Optional[str] = None
      version: _typing.Optional[str] = None

   @property
   def catalog(self) -> list[LocalizationManager.MessageCatalog]:
      """
      Fetches the descriptions of all the client-side localization message
      catalogs available for the current session locale.
      """
      ...


