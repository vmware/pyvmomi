class VsanPropertyConstraint(VsanResourceConstraint):
   """
   Defines a criteria for matching resources based on conditions on their
   resource model properties.
   
   For example, it could be used to match all
   `VirtualMachine` resources which are powered on, etc.
   
   Attributes:
       propertyName: The name of the resource model property to be evaluated by this constraint.
           
           For example: `runtime.host`.
           
           If a value is not specified, i.e., `null` the constraint will
           evaluate all properties of the kind implied by the interpretation context,
           e.g., if used in a `PropertyConstraint` with the operator
           `TEXTUALLY_MATCHES`,
           it'd imply all textual properties.
       comparator: Defines the possible operators to use for comparison of the resource
           model properties.
       comparableValue: The value to be compared against the specified resource model property.
           
           Could be
           * an array if the comparison operator works on a range of values.
   """
   propertyName: _typing.Optional[str] = None
   comparator: _typing.Optional[str] = None
   comparableValue: _typing.Optional[pyVmomi.vmodl.KeyAnyValue] = None

class VsanPropertyConstraintComparatorEnum:
   """
   Defines the possible operators to use for comparison of the resource
   model properties.
   """
   pass


