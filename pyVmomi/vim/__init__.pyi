class CustomFieldsManager(pyVmomi.VmomiSupport.ManagedObject):
   """
   The CustomFieldsManager object is used to add and remove custom fields
   to managed entities.
   
   The custom fields values set on managed entities are available through the
   `pyVmomi.vim.ManagedEntity.customValue` property and through the summary objects
   for `pyVmomi.vim.VirtualMachine` and `pyVmomi.vim.HostSystem`. They are not available
   directly through this managed object.
   
   This functionality is only available through VirtualCenter.
   """
   class FieldDef(pyVmomi.vmodl.DynamicData):
      """
      Describes a custom field.
      
      Attributes:
          key: A unique ID used to reference this custom field in assignments.
              
              This
              ID is unique for the lifetime of the field (even across
              rename operations).
          name: Name of the field.
          type: Type of the field.
          managedObjectType: Type of object for which the field is valid.
              
              If not specified,
              the field is valid for all managed objects.
          fieldDefPrivileges: The set of privileges to apply on this field definition
          fieldInstancePrivileges: The set of privileges to apply on instances of this field
      """
      key: int
      name: str
      type: type
      managedObjectType: _typing.Optional[type] = None
      fieldDefPrivileges: _typing.Optional[PrivilegePolicyDef] = None
      fieldInstancePrivileges: _typing.Optional[PrivilegePolicyDef] = None

   class Value(pyVmomi.vmodl.DynamicData):
      """
      Base type for storing values.
      
      Attributes:
          key: The ID of the field to which this value belongs.
      """
      key: int

   class StringValue(CustomFieldsManager.Value):
      """
      Subtype for string values (currently the only supported type).
      
      Attributes:
          value: Value assigned to the custom field.
      """
      value: str

   @property
   def field(self) -> list[CustomFieldsManager.FieldDef]:
      """
      List of custom fields defined on this server.
      
      The fields are
      sorted by name.
      """
      ...

   def AddFieldDefinition(self, name: str, moType: _typing.Optional[type], fieldDefPolicy: _typing.Optional[PrivilegePolicyDef], fieldPolicy: _typing.Optional[PrivilegePolicyDef]) -> CustomFieldsManager.FieldDef:
      """
      Creates a new custom field.
      
      If the moType is specified, the
      field will only be available for that type of managed object.
      
      Args:
          name: The name of the field.
          moType: The managed object type to which this field
              will apply
          fieldDefPolicy: Privilege policy to apply to FieldDef being
              created
          fieldPolicy: Privilege policy to apply to instances of field
      
      Raises:
          pyVmomi.vim.fault.DuplicateName: if a custom field with the name already exists.
          pyVmomi.vim.fault.InvalidPrivilege: if a specified privilege is not defined.
      """
      ...
   def RemoveFieldDefinition(self, key: int) -> None:
      """
      Removes a custom field.
      
      This also removes all values assigned
      to this custom field.
      
      Args:
          key: The unique key for the field definition.
      """
      ...
   def RenameFieldDefinition(self, key: int, name: str) -> None:
      """
      Renames a custom field.
      
      Args:
          key: The unique key for the field definition.
          name: The new name for the field.
      
      Raises:
          pyVmomi.vim.fault.DuplicateName: if a custom field with the name already exists.
      """
      ...
   def SetField(self, entity: ManagedEntity, key: int, value: str) -> None:
      """Assigns a value to a custom field on an entity."""
      ...


class CustomizationSpecInfo(pyVmomi.vmodl.DynamicData):
   """
   Information about a specification.
   
   Attributes:
       name: Unique name of the specification.
       description: Description of the specification.
       type: Guest operating system for this specification (Linux or Windows).
       changeVersion: The changeVersion is a unique identifier for a given version
           of the configuration.
           
           Each change to the configuration will
           update this value. This is typically implemented as an ever
           increasing count or a time-stamp. However, a client should
           always treat this as an opaque string.
           
           If specified when updating a specification, the changes will only be
           applied if the current changeVersion matches the specified changeVersion. This
           field can be used to guard against updates that has happened
           between the configInfo was read and until it is applied.
       lastUpdateTime: Time when the specification was last modified.
           
           This time is ignored when
           the CustomizationSpecItem containing this is used as an input to
           CustomizationSpecManager.create.
   """
   name: str
   description: str
   type: str
   changeVersion: _typing.Optional[str] = None
   lastUpdateTime: _typing.Optional[_datetime.datetime] = None


