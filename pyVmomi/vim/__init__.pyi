class ClusterComputeResource(ComputeResource):
   """
   The `pyVmomi.vim.ClusterComputeResource` data object aggregates the compute
   resources of associated `pyVmomi.vim.HostSystem` objects into a single
   compute resource for use by virtual machines.
   
   The cluster services
   such as HA (High Availability), DRS (Distributed Resource Scheduling),
   and EVC (Enhanced vMotion Compatibility), enhance the utility of this
   single compute resource.
   
   Use the `pyVmomi.vim.Folder`.`pyVmomi.vim.Folder.createClusterEx` method
   to create an instance of this object.
   """
   class Summary(ComputeResource.Summary):
      """
      The `pyVmomi.vim.ClusterComputeResource.Summary` data object
      encapsulates runtime properties of a `pyVmomi.vim.ClusterComputeResource`.
      
      Attributes:
          currentFailoverLevel: Current failover level.
              
              This is the number of physical host failures that can
              be tolerated without impacting the ability to satisfy the minimums for all
              running virtual machines. This represents the current value, as opposed to
              desired value configured by the user.
          admissionControlInfo: Information about the current amount of resources available for a vSphere HA
              cluster.
              
              The actual type of admissionControlInfo will depend on what kind of
              `pyVmomi.vim.cluster.DasAdmissionControlPolicy` was used to configure the cluster.
          numVmotions: Total number of migrations with VMotion that have been done internal to this
              cluster.
          targetBalance: The target balance, in terms of standard deviation, for a DRS cluster.
              
              Units are thousandths. For example, 12 represents 0.012.
          currentBalance: The current balance, in terms of standard deviation, for a DRS cluster.
              
              Units are thousandths. For example, 12 represents 0.012.
          drsScore: The DRS score of this cluster, in percentage.
          numVmsPerDrsScoreBucket: The number of VMs in this cluster corresponding to each DRS score
              bucket.
              
              The buckets are defined as follows:
              - 0% - 20%
              - 21% - 40%
              - 41% - 60%
              - 61% - 80%
              - 81% - 100%
          usageSummary: The current usage summary for a DRS cluster.
          currentEVCModeKey: The Enhanced VMotion Compatibility mode that is currently in effect
              for all hosts in this cluster; unset if no EVC mode is active.
          currentEVCGraphicsModeKey: The Enhanced VMotion Compatibility Graphics mode that is currently in
              effect for all hosts in this cluster; unset if no EVC mode is active.
              
              Since: vSphere API Release 7.0.1.0
          dasData: Data pertaining to DAS.
          clusterMaintenanceModeStatus: Configuration pertinent to state of the cluster maintenance mode.
              
              Valid values are enumerated by the `pyVmomi.vim.ClusterComputeResource.ClusterMaintenanceModeStatus`
              type.
              
              Since: vSphere API Release 7.0.0.2
          vcsHealthStatus: The health status of the vSphere Cluster Services in the cluster.
              
              Supported values are enumerated by the `pyVmomi.vim.ClusterComputeResource.VcsHealthStatus`
              type.
              
              Since: vSphere API Release 7.0.1.1
          vcsSlots: An array of hosts and number of resource slots on the host for
              vSphere Cluster Services in the cluster.
              
              The number of resource slots on the host includes both following types:
              1\\. Number of vCS VMs running on the host (resource reserved and occupied).
              2\\. Number of reserved and unoccupied slots (reserved for new vCS VMs).
              
              Since: vSphere API Release 7.0.1.1
      """
      currentFailoverLevel: int
      admissionControlInfo: _typing.Optional[pyVmomi.vim.cluster.DasAdmissionControlInfo] = None
      numVmotions: int
      targetBalance: _typing.Optional[int] = None
      currentBalance: _typing.Optional[int] = None
      drsScore: _typing.Optional[int] = None
      numVmsPerDrsScoreBucket: list[int] = []
      usageSummary: _typing.Optional[pyVmomi.vim.cluster.UsageSummary] = None
      currentEVCModeKey: _typing.Optional[str] = None
      currentEVCGraphicsModeKey: _typing.Optional[str] = None
      dasData: _typing.Optional[pyVmomi.vim.cluster.DasData] = None
      clusterMaintenanceModeStatus: _typing.Optional[str] = None
