class Extension(pyVmomi.vmodl.DynamicData):
   """
   This data object type contains all information about an extension.
   
   An extension may contain zero or more server interfaces and zero
   or more clients.
   
   Attributes:
       description: Description of extension.
       key: Extension key.
           
           Should follow java package naming conventions
           for uniqueness (e.g. \"com.example.management\").
           
           Extension names can only contain characters belonging to the
           lower ASCII character set (UTF-7) with the exception of the
           following characters:
           1. All whitespace characters (\"space\" - ascii character 0x20 is allowed)
           2. Control characters
           3. Comma (ascii 0x2c), Forward slash (ascii 0x2f), Backward slash (ascii 0x5c),
              Hash/Pound (ascii 0x23), Plus (ascii 0x2b), Greater (ascii 0x3e), Lesser (ascii 0x3c),
              Equals (ascii 0x3d), Semi-colon (ascii 0x3b) and Double quote (ascii 0x22).
       company: Company information.
       type: Type of extension (example may include CP-DVS, NUOVA-DVS, etc.).
       version: Extension version number as a dot-separated string.
           
           For example, \"1.0.0\"
       subjectName: Subject name from client certificate.
       server: Servers for this extension.
       client: Clients for this extension.
       taskList: Definitions of tasks defined by this extension.
       eventList: Definitions of events defined by this extension.
       faultList: Definitions of faults defined by this extension.
       privilegeList: Definitions privileges defined by this extension.
       resourceList: Resource data for all locales
       lastHeartbeatTime: Last extension heartbeat time.
       healthInfo: Health specification provided by this extension.
       ovfConsumerInfo: OVF consumer specification provided by this extension.
       extendedProductInfo: Extended product information, such as URLs to vendor, product, etc.
       managedEntityInfo: Information about entities managed by this extension.
           
           An extension can
           register virtual machines as managed by itself, by setting the
           `pyVmomi.vim.vm.ConfigSpec.managedBy` property of the virtual
           machine.
       shownInSolutionManager: Opt-in to the Solution Manager.
           
           If set to true, this extension will be
           shown in the Solution Manager. If not set, or set to false, this extension
           is not shown in the Solution Manager.
       solutionManagerInfo: Solution Manager configuration for this extension.
   """
   class ServerInfo(pyVmomi.vmodl.DynamicData):
      """
      This data object type describes a server for the extension.
      
      Attributes:
          url: Server url.
          description: Server description.
          company: Company information.
          type: Type of server (examples may include SOAP, REST, HTTP, etc.).
          adminEmail: Extension administrator email addresses.
          serverThumbprint: Thumbprint of the extension server certificate presented to clients
          serverCertificate: X.509 certificate of the extension server presented to clients in PEM
              format according to RFC 7468
              
              Since: vSphere API Release 8.0.2.0
      """
      url: str
      description: Description
      company: str
      type: str
      adminEmail: list[str] = []
      serverThumbprint: _typing.Optional[str] = None
      serverCertificate: _typing.Optional[str] = None

   class ClientInfo(pyVmomi.vmodl.DynamicData):
      """
      This data object type describes a client of the extension.
      
      Attributes:
          version: Client version number as a dot-separated string.
              
              For example, \"1.0.0\"
          description: Description of client.
          company: Company information.
          type: Type of client (examples may include win32, .net, linux, etc.).
          url: Plugin url.
      """
      version: str
      description: Description
      company: str
      type: str
      url: str

   class TaskTypeInfo(pyVmomi.vmodl.DynamicData):
      """
      This data object type describes task types defined by the extension.
      
      Attributes:
          taskID: The ID of the task type.
              
              Should follow java package
              naming conventions for uniqueness.
      """
      taskID: str

   class EventTypeInfo(pyVmomi.vmodl.DynamicData):
      """
      This data object type describes event types defined by the extension.
      
      Attributes:
          eventID: The ID of the event type.
              
              Should follow java package
              naming conventions for uniqueness.
          eventTypeSchema: Optional XML descriptor for the EventType.
              
              The structure of this descriptor is:
              
                   <EventType>
                     <eventTypeID>eventID</eventTypeID>
                     <description>Optional description for event eventID</description>
                     <-- Optional arguments: -->
                     <arguments>
                        <-- Zero or more of: -->
                        <argument>
                          <name>argName</name>
                          <type>argtype</name>
                        </argument>
                     </arguments>
                   </EventType>
              where argtype can be one of the following:
              - This is an example list and should be considered as incomplete.
              <!-- -->
              - Primitive types:
                - string
                - bool
                - int
                - long
                - float
                - moid
              - Entity reference types:
                - vm
                - host
                - resourcepool
                - computeresource
                - datacenter
                - datastore
                - network
                - dvs
      """
      eventID: str
      eventTypeSchema: _typing.Optional[str] = None

   class FaultTypeInfo(pyVmomi.vmodl.DynamicData):
      """
      This data object type describes fault types defined by the extension.
      
