class MacAddress(NegatableExpression):
   """Base class for specifying MAC addresses."""
   pass

class MacRange(MacAddress):
   """
   This class defines a range of MAC address.
   
   Attributes:
       address: MAC address.
       mask: Mask that is used in matching the MAC address.
           
           A MAC address is
           considered matched if the \"and\" operation of the mask on the
           MAC address and `pyVmomi.vim.MacRange.address` yields the same result.
           For example, a MAC of \"00:A0:FF:14:FF:29\" is considered matched
           for a `pyVmomi.vim.MacRange.address` of \"00:A0:C9:14:C8:29\" and a
           `pyVmomi.vim.MacRange.mask` of \"FF:FF:00:FF:00:FF\".
   """
   address: str
   mask: str


