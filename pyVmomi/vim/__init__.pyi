      PROJECT: _typing.ClassVar['Folder.ExternallyManagedFolderType'] = 'PROJECT'
      VPC_ROOT: _typing.ClassVar['Folder.ExternallyManagedFolderType'] = 'VPC_ROOT'
      VPC: _typing.ClassVar['Folder.ExternallyManagedFolderType'] = 'VPC'
      SUBNET: _typing.ClassVar['Folder.ExternallyManagedFolderType'] = 'SUBNET'
      SEGMENT: _typing.ClassVar['Folder.ExternallyManagedFolderType'] = 'SEGMENT'
      SUPERVISOR: _typing.ClassVar['Folder.ExternallyManagedFolderType'] = 'SUPERVISOR'
      VSPHERE_POD: _typing.ClassVar['Folder.ExternallyManagedFolderType'] = 'VSPHERE_POD'

