          pyVmomi.vim.fault.FileFault: If there is a generic file error.
      
      Since: vSphere API Release 8.0.2.0
      """
      ...


class Folder(ManagedEntity):
   """
   The `pyVmomi.vim.Folder` managed object is a container for storing and organizing
   inventory objects.
   
   Folders can contain folders and other objects.
   The `pyVmomi.vim.Folder.childType` property identifies a folder's type
   and determines the types of folders and objects the folder can contain.
   - A folder can contain a child folder of the same type as the parent folder.
   - All `pyVmomi.vim.Datacenter` objects contain dedicated folders for:
     - `pyVmomi.vim.VirtualMachine`, templates, and `pyVmomi.vim.VirtualApp` objects.
     - `pyVmomi.vim.ComputeResource` hierarchies.
     - `pyVmomi.vim.Network`, `pyVmomi.vim.DistributedVirtualSwitch`, and
       `pyVmomi.vim.dvs.DistributedVirtualPortgroup` objects.
     - `pyVmomi.vim.Datastore` objects.
   - A folder can contain child objects of type `pyVmomi.vim.Folder.childType`.
     Virtual machine and network entity folders can also contain additional object types.
   - The root folder is a data center folder.
     
   See `pyVmomi.vim.ServiceInstance` for a representation of the organization of the inventory.
   
   The `pyVmomi.vim.Folder` managed object also acts as a factory object, meaning it
   creates new entities in a folder. The object provides methods to create
   child folders and objects, methods to add existing objects to folders, and
   methods to remove objects from folders and to delete folders.
   
   `pyVmomi.vim.Folder` inherits the `pyVmomi.vim.ManagedEntity.destroy` method.
   `pyVmomi.vim.ManagedEntity.destroy` is a recursive operation that removes all child objects and
   folders. When you call `pyVmomi.vim.ManagedEntity.destroy` to destroy a folder, the system uses
   the specified folder as a root and traverses its descendant hierarchy, calling
   `pyVmomi.vim.ManagedEntity.destroy` on each object.
   `pyVmomi.vim.ManagedEntity.destroy` is a single operation that treats each recursive call as a
   single transaction, committing each call to remove an object individually.
   If `pyVmomi.vim.ManagedEntity.destroy` fails on an object, the method terminates at that point
   with an exception, leaving some or all of the objects still in the inventory.
   
   Notes on the folder destroy method:
   - Calling `pyVmomi.vim.ManagedEntity.destroy` on a virtual machine folder recursively calls
     `pyVmomi.vim.ManagedEntity.destroy` on all the child virtual machines and vApps, which are then
     removed from disk.
     Use `pyVmomi.vim.Folder.unregisterAndDestroy`
     to unregister virtual machines or vApps recursively without
     removing them from the disk.
   - For virtual machine folders, the `pyVmomi.vim.ManagedEntity.destroy` method requires the
     VirtualMachine.Delete privilege on the folder as well as
     all virtual machines to be destroyed. It also requires the VirtualApp.Delete
     privilege on all VirtualApp objects to be destroyed.
   - Destroying a host folder or datacenter folder unregisters all child hosts
     and virtual machines from vCenter. The hosts are simply removed
     from the inventory, along with their virtual machines. The virtual machines
     are not removed from disk nor are their runtime states changed.
   - You can remove network and datastore folders only if they are empty.
   - You cannot destroy, rename, or move the virtual machine, compute resource,
     network entity, and datastore child folders of a Datacenter.
   """
   class DesiredHostState(pyVmomi.VmomiSupport.Enum):
      """
      Attributes:
          maintenance: Add host in maintenance mode.
          non_maintenance: Add host in non-maintenance mode.
      """
      maintenance: _typing.ClassVar['Folder.DesiredHostState'] = 'maintenance'
      non_maintenance: _typing.ClassVar['Folder.DesiredHostState'] = 'non_maintenance'

   class NewHostSpec(pyVmomi.vmodl.DynamicData):
      """
      Attributes:
          hostCnxSpec: Connection Spec for new host that needs to be added to the inventory.
          esxLicense: LicenseKey.
              
              See `pyVmomi.vim.LicenseManager`. If supplied, new
              host will be updated with the license.
      """
      hostCnxSpec: pyVmomi.vim.host.ConnectSpec
      esxLicense: _typing.Optional[str] = None

   class FailedHostResult(pyVmomi.vmodl.DynamicData):
      """
      Attributes:
          hostName: Host name for which fault belongs to.
          host: Host for which fault belongs to.
              
              Only set when the HostSystem
              reference is available as a result of Host being part of inventory.
          context: Message describing context where the failure happened.
          fault: Exception encountered while operating on this host.
      """
      hostName: _typing.Optional[str] = None
      host: _typing.Optional[HostSystem] = None
      context: pyVmomi.vmodl.LocalizableMessage
      fault: pyVmomi.vmodl.MethodFault

   class BatchAddStandaloneHostsResult(pyVmomi.vmodl.DynamicData):
      """
      Attributes:
          addedHosts: List of hosts that were successfully added as standalone hosts
              to the inventory.
          hostsFailedInventoryAdd: Contains a fault for each host that failed to add.
              
              A failed host
              will not be part of addedHosts list.
      """
      addedHosts: list[HostSystem] = []
      hostsFailedInventoryAdd: list[Folder.FailedHostResult] = []

   class BatchAddHostsToClusterResult(pyVmomi.vmodl.DynamicData):
      """
      Attributes:
          hostsAddedToCluster: List of hosts that were successfully added to the cluster
              in the desired state.
          hostsFailedInventoryAdd: Contains a fault for each host that failed addition to the inventory.
              
              A failed host will not be part of hostsAddedToCluster list.
          hostsFailedMoveToCluster: List of hosts that are part of inventory but failed to move to the
              cluster in the desired state.
              
