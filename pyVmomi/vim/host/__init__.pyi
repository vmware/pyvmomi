   class ConfigOption(pyVmomi.vmodl.DynamicData):
      """
      Attributes:
          blockSizeOption: Supported values of VMFS block size in kilobytes (KB)
              `pyVmomi.vim.host.VmfsVolume.blockSize`.
          unmapGranularityOption: Supported values of VMFS unmap granularity
