class RdmaDevice(pyVmomi.vmodl.DynamicData):
   """
   This data object represents a Remote Direct Memory Access
   device as seen by the primary operating system.
   
   Attributes:
       key: The linkable identifier.
       device: The device name of the RDMA device.
       driver: The short string name of the device driver, if available.
       description: Device description, if available.
       backing: If set, represents the physical backing for the RDMA device.
           
           Not all RDMA devices are required to have a physical backing.
       connectionInfo: Current device connection state.
       capability: Supported capabilities of the RDMA device.
   """
   class Backing(pyVmomi.vmodl.DynamicData):
      """
      This data object represents the physical
      backing of an RDMA device.
      """
      pass

   class PnicBacking(RdmaDevice.Backing):
      """
      This data object represents a physical NIC backing
      for an RDMA device.
      
      When an RDMA device is backed by a physical NIC, it
      can be associated with the virtual NICs
      connected to a virtual switch which has the
      backing physical NIC as an uplink. The actual bindings
      are created and destroyed dynamically based on application
      usage of the RDMA device.
      
      Attributes:
          pairedUplink: The associated physical NIC
      """
      pairedUplink: PhysicalNic

   class ConnectionState(pyVmomi.VmomiSupport.Enum):
      """
      Possible RDMA device connection states.
      
      These correspond
      to possible link states as defined by the
      Infiniband (TM) specification.
      
      Further details can be found in:
      - \"Infiniband (TM) Architecture Specification, Volume 1\"
        section 7.2 \"Link states\"
      
      Attributes:
          unknown: Connection state unknown.
              
              Indicates that the driver returned
              unexpected or no connection state information.
          down: Device down.
              
              Indicates that both the logical link and
              underlying physical link are down. Packets
              are discarded.
          init: Device initializing.
              
              Indicates that the physical link is up, but
              the logical link is still initializing.
              Only subnet management and flow control link
              packets can be received and transmitted.
          armed: Device armed.
              
              Indicates that the physical link is up, but
              the logical link is not yet fully configured.
              Packets can be received, but non-SMPs
              (subnet management packets) to be sent are discarded.
          active: Device active.
              
              Indicates that both the physical and logical
              link are up. Packets can be transmitted and received.
          activeDefer: Device in active defer state.
              
              Indicates that the logical link was active, but the
              physical link has suffered a failure. If it recovers
              within a timeout, the connection state will return to active,
              otherwise it will move to down.
      """
      unknown: _typing.ClassVar['RdmaDevice.ConnectionState'] = 'unknown'
      down: _typing.ClassVar['RdmaDevice.ConnectionState'] = 'down'
      init: _typing.ClassVar['RdmaDevice.ConnectionState'] = 'init'
      armed: _typing.ClassVar['RdmaDevice.ConnectionState'] = 'armed'
      active: _typing.ClassVar['RdmaDevice.ConnectionState'] = 'active'
      activeDefer: _typing.ClassVar['RdmaDevice.ConnectionState'] = 'activeDefer'

   class ConnectionInfo(pyVmomi.vmodl.DynamicData):
      """
      Represents connection information for the RDMA device.
      
      Attributes:
          state: RDMA device connection state.
              
              The set of possible values
              is described in `pyVmomi.vim.host.RdmaDevice.ConnectionState`.
          mtu: Maximum Transmission Unit in bytes.
          speedInMbps: Bit rate in Mbps.
      """
      state: str
      mtu: int
      speedInMbps: int

   class Capability(pyVmomi.vmodl.DynamicData):
      """
      Represents device capabilities, e.g.
      
      supported protocols.
      
      Attributes:
          roceV1Capable: Indicates whether ROCEv1 is supported by the device.
          roceV2Capable: Indicates whether ROCEv2 is supported by the device.
          iWarpCapable: Indicates whether iWARP is supported by the device.
      """
      roceV1Capable: bool
      roceV2Capable: bool
      iWarpCapable: bool

   key: str
   device: str
   driver: _typing.Optional[str] = None
   description: _typing.Optional[str] = None
   backing: _typing.Optional[RdmaDevice.Backing] = None
   connectionInfo: RdmaDevice.ConnectionInfo
   capability: RdmaDevice.Capability


