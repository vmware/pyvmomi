      Attributes:
          changeOperation: Indicates the change operation to apply on this configuration
              specification.
          spec: The specification volume.
      """
      changeOperation: _typing.Optional[str] = None
      spec: _typing.Optional[NasVolume.Specification] = None

   remoteHost: str
   remotePath: str
   userName: _typing.Optional[str] = None
   remoteHostNames: list[str] = []
   securityType: _typing.Optional[str] = None
   protocolEndpoint: _typing.Optional[bool] = None


class NatService(pyVmomi.vmodl.DynamicData):
   """
   A network address translation (NAT) service instance provides
   firewall and network address translation services for a virtual
   network.
   
   Attributes:
       key: The instance ID of the NAT service.
       spec: The configurable properties for the NatService object.
   """
   class PortForwardSpecification(pyVmomi.vmodl.DynamicData):
      """
      This data object type describes the
      Network Address Translation (NAT) port forwarding specification.
      
      Attributes:
          type: Either \"tcp\" or \"udp\".
          name: The user-defined name to identify the service being forwarded.
              
              No white spaces are allowed in the string.
          hostPort: The port number on the host.
              
              Network traffic sent to the host on this
              TCP/UDP port is forwarded to the guest at the specified IP address
              and port.
          guestPort: The port number for the guest.
              
