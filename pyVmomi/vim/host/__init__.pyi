   class Specification(pyVmomi.vmodl.DynamicData):
      """
      The `pyVmomi.vim.host.VirtualNic.Specification` data object describes the
      `pyVmomi.vim.host.VirtualNic` configuration containing both the configured
      properties on a virtual NIC and identification information.
      
      Attributes:
          ip: IP configuration on the virtual network adapter.
          mac: Media access control (MAC) address of the virtual network adapter.
          distributedVirtualPort: `pyVmomi.vim.dvs.DistributedVirtualPort` or `pyVmomi.vim.dvs.DistributedVirtualPortgroup`
              connection.
              
              To specify a port connection, set
              `pyVmomi.vim.dvs.PortConnection.switchUuid` and `pyVmomi.vim.dvs.PortConnection.portKey`
              properties. To specify a portgroup connection, set
              `pyVmomi.vim.dvs.PortConnection.switchUuid` and `pyVmomi.vim.dvs.PortConnection.portgroupKey`
              properties.
              
              When reconfiguring a virtual NIC, this property indicates the new portgroup
              to which the virtual NIC should connect. You can specify this property
              only if you do not specify `pyVmomi.vim.host.VirtualNic.Specification.distributedVirtualPort` and
              `pyVmomi.vim.host.VirtualNic.Specification.opaqueNetwork`
          portgroup: Portgroup (`pyVmomi.vim.host.PortGroup`) to which the virtual NIC is connected.
              
              When reconfiguring a virtual NIC, this property indicates the new portgroup
              to which the virtual NIC should connect. You can specify this property
              only if you do not specify `pyVmomi.vim.host.VirtualNic.Specification.distributedVirtualPort` and
              `pyVmomi.vim.host.VirtualNic.Specification.opaqueNetwork`
          mtu: Maximum transmission unit for packets size in bytes for the virtual
              NIC.
              
              If not specified, the Server will use the system default value.
          tsoEnabled: Flag enabling or disabling TCP segmentation offset for a virtual NIC.
              
