              Allowed values 16 to 160
              Default Value 16
      """
      bytes: _typing.Optional[pyVmomi.VmomiSupport.long] = None
      iops: _typing.Optional[pyVmomi.VmomiSupport.long] = None
      path: _typing.Optional[str] = None
