          pyVmomi.vim.fault.NotFound: if the named VMFS datastore is not found.
          pyVmomi.vim.fault.HostConfigFault: if unable to query disk information.
      """
      ...
   def QueryVmfsDatastoreCreateOptions(self, devicePath: str, vmfsMajorVersion: _typing.Optional[int]) -> list[VmfsDatastoreOption]:
      """
      Queries options for creating a new VMFS datastore for a disk.
      
      See Also: `pyVmomi.vim.host.ScsiDisk.devicePath`
      
      Args:
