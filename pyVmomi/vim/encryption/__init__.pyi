class CryptoSpec(pyVmomi.vmodl.DynamicData):
   """
   This data object type encapsulates virtual machine or disk encryption
   settings.
   """
   pass

class CryptoSpecDecrypt(CryptoSpec):
   """
   This data object type encapsulates virtual machine or disk encryption
   settings for decryption operation.
   """
   pass

class CryptoSpecDeepRecrypt(CryptoSpec):
   """
   This data object type encapsulates virtual machine or disk cryptographic
   settings for deep reencryption operation.
   """
   newKeyId: CryptoKeyId

class CryptoSpecEncrypt(CryptoSpec):
   """
   This data object type encapsulates virtual machine or disk cryptohraphic
   settings for encryption operation.
   """
   cryptoKeyId: CryptoKeyId

class CryptoSpecNoOp(CryptoSpec):
   """
   This data object type indicates that the encryption settings of the
   virtual machine or disk should not be modified by the operation.
   """
   pass

class CryptoSpecRegister(CryptoSpecNoOp):
   """
   This data object type indicates that the operation requires keys to be sent
   but the encryption settings of the virtual machine or disk
   should not be modified by the operation.
   
   Attributes:
       cryptoKeyId: The key the VM/disk is already encrypted with.
   """
   cryptoKeyId: CryptoKeyId

class CryptoSpecShallowRecrypt(CryptoSpec):
   """
   This data object type encapsulates virtual machine or disk cryptographic
   settings for shallow reencryption operation.
   """
   newKeyId: CryptoKeyId


class KeyProviderId(pyVmomi.vmodl.DynamicData):
   """
   Data Object representing a crypto key provider's unique identifier.
   
   Attributes:
       id: Globally unique ID for the crypto key provider.
           
           Servers with the same ID must provide the same keys.
           Cannot be empty.
   """
   id: str


class KmipClusterInfo(pyVmomi.vmodl.DynamicData):
   """
   Data Object representing a cluster of KMIP servers.
   
   All servers in a cluster must provide the same keys.
   
   Attributes:
       clusterId: Globally unique ID for the servers providing the same keys.
           
           All KMIP servers with the same clusterId are in a cluster and all must
           provide the same keys for redundancy.
       servers: Servers in this cluster.
       useAsDefault: Use this cluster as default for system wide,
           when the optional CryptoKeyId.providerId is not set.
       managementType: Key provider management type.
           
           See `pyVmomi.vim.encryption.KmipClusterInfo.KmsManagementType` for valid values.
       useAsEntityDefault: Use this cluster as default for the managed entities,
           when the optional CryptoKeyId.providerId is not set.
           
           See `pyVmomi.vim.encryption.CryptoManagerKmip.setDefaultKmsCluster` for
           supported managed entity type.
       hasBackup: Since: vSphere API Release 7.0.2.0
       tpmRequired: Since: vSphere API Release 7.0.2.0
       keyId: Since: vSphere API Release 7.0.2.0
       defaultKeyType: Key type which the key provider generates by default.
           
           See `pyVmomi.vim.encryption.KmipClusterInfo.KeyType` for supported values.
           
           Since: vSphere API Release 9.0.0.0
       keyInfo: Key information.
           
           Since: vSphere API Release 9.0.0.0
   """
   class KmsManagementType(pyVmomi.VmomiSupport.Enum):
      """
      Key provider management type.
      
      Attributes:
          nativeProvider: Since: vSphere API Release 7.0.2.0
      """
      unknown: _typing.ClassVar['KmipClusterInfo.KmsManagementType'] = 'unknown'
      vCenter: _typing.ClassVar['KmipClusterInfo.KmsManagementType'] = 'vCenter'
      trustAuthority: _typing.ClassVar['KmipClusterInfo.KmsManagementType'] = 'trustAuthority'
      nativeProvider: _typing.ClassVar['KmipClusterInfo.KmsManagementType'] = 'nativeProvider'

   class KeyType(pyVmomi.VmomiSupport.Enum):
      """
      Key type.
      
      Attributes:
          rawKey: Key is fetched directly from KMS.
          wrappedKey: Key is wrapped by a wrapping key from KMS.
              
              The wrapping key details are specified in
              `pyVmomi.vim.encryption.KmipClusterInfo.WrappingKeyIdKeyInfo`
              or
              `pyVmomi.vim.encryption.KmipClusterInfo.WrappingRotationIntervalKeyInfo`.
      
      Since: vSphere API Release 9.0.0.0
      """
      rawKey: _typing.ClassVar['KmipClusterInfo.KeyType'] = 'rawKey'
      wrappedKey: _typing.ClassVar['KmipClusterInfo.KeyType'] = 'wrappedKey'

   class KeyInfo(pyVmomi.vmodl.DynamicData):
      """
      Base class of key information.
      
      Since: vSphere API Release 9.0.0.0
      """
      pass

   class WrappingKeyIdKeyInfo(KmipClusterInfo.KeyInfo):
      """
      Wrapping key ID key information.
      
      Attributes:
          keyId: Wrapping key identifier.
          configuredTime: The time when `pyVmomi.vim.encryption.KmipClusterInfo.WrappingKeyIdKeyInfo.keyId` was set as the wrapping key ID.
      
      Since: vSphere API Release 9.0.0.0
      """
      keyId: str
      configuredTime: _datetime.datetime

   class WrappingRotationIntervalKeyInfo(KmipClusterInfo.KeyInfo):
      """
      Wrapping rotation interval key information.
      
      Attributes:
          keyId: Wrapping key identifier.
          rotationInterval: Wrapping key rotation interval (number of days).
          lastRotation: Last wrapping key rotation timestamp.
      
      Since: vSphere API Release 9.0.0.0
      """
      keyId: _typing.Optional[str] = None
      rotationInterval: _typing.Optional[int] = None
      lastRotation: _typing.Optional[_datetime.datetime] = None

   clusterId: KeyProviderId
   servers: list[KmipServerInfo] = []
   useAsDefault: bool
   managementType: _typing.Optional[str] = None
   useAsEntityDefault: list[pyVmomi.vim.ManagedEntity] = []
   hasBackup: _typing.Optional[bool] = None
   tpmRequired: _typing.Optional[bool] = None
   keyId: _typing.Optional[str] = None
   defaultKeyType: _typing.Optional[str] = None
   keyInfo: _typing.Optional[KmipClusterInfo.KeyInfo] = None


class KmipServerInfo(pyVmomi.vmodl.DynamicData):
   """
   Data Object representing a KMIP server connection information.
   
   Attributes:
       name: Name for the KMIP server.
       address: Address of the KMIP server.
       port: Port of the KMIP server.
       proxyAddress: Address of the proxy server.
           
           Set value to empty string to delete the entry.
       proxyPort: Port of the proxy server.
           
           Set value \"-1\" to delete the entry.
       reconnect: Should auto-reconnect be done.
           
           Set value \"-1\" to delete the entry.
       protocol: KMIP library protocol handler, e.g.
           
           KMIP1.
           Set value to empty string to delete the entry.
       nbio: Non-blocking I/O required.
           
           Set value \"-1\" to delete the entry.
       timeout: I/O timeout in seconds (-1=none,0=infinite).
           
           Set value \"-1\" to delete the entry.
       userName: Username to authenticate to the KMIP server.
           
           Set value to empty string to delete the entry.
   """
   name: str
   address: str
   port: int
   proxyAddress: _typing.Optional[str] = None
   proxyPort: _typing.Optional[int] = None
   reconnect: _typing.Optional[int] = None
   protocol: _typing.Optional[str] = None
   nbio: _typing.Optional[int] = None
   timeout: _typing.Optional[int] = None
   userName: _typing.Optional[str] = None


class KmipServerSpec(pyVmomi.vmodl.DynamicData):
   """
   Data Object representing a KMIP server connection spec.
   
   Attributes:
       clusterId: The ID of the KMIP cluster.
           
           KMIP servers with the same clusterId are in
           one cluster and provide the same keys for redundancy.
       info: Connection information for the KMIP server.
       password: Password to authenticate to the KMIP server.
           
           Set value to empty string to delete the entry.
       defaultKeyType: Key type which the key provider generates by default.
           
           See `pyVmomi.vim.encryption.KmipClusterInfo.KeyType` for supported values.
           
           Since: vSphere API Release 9.0.0.0
       keySpec: Specification of key.
           
           Since: vSphere API Release 9.0.0.0
   """
   class KeySpec(pyVmomi.vmodl.DynamicData):
      """
      Base class of key specification.
      
      Since: vSphere API Release 9.0.0.0
      """
      pass

   class WrappingKeyIdKeySpec(KmipServerSpec.KeySpec):
      """
      Wrapping key ID key specification.
      
      Key rotation will not occur automatically when a client
      specified key ID is used.
      
      Attributes:
          keyId: Wrapping key identifier.
      
      Since: vSphere API Release 9.0.0.0
      """
      keyId: str

   class WrappingRotationIntervalKeySpec(KmipServerSpec.KeySpec):
      """
      Wrapping rotation interval key specification.
      
      The wrapping key will be created automatically and will rotate
      automatically based on the rotation interval.
      
      Attributes:
          rotationInterval: Wrapping key regular rotation interval (number of days).
              
              The allowed minimum number of days is 30 days,
              and maximum number of days is 3650 days.
              If not set, then a system default number of days will be used.
      
      Since: vSphere API Release 9.0.0.0
      """
      rotationInterval: _typing.Optional[int] = None

   clusterId: KeyProviderId
   info: KmipServerInfo
   password: _typing.Optional[str] = None
   defaultKeyType: _typing.Optional[str] = None
   keySpec: _typing.Optional[KmipServerSpec.KeySpec] = None


